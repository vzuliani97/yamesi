# Copy to .env and change the values. .env is git-ignored.
POSTGRES_PASSWORD=yamesi_local_password
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Object storage credentials (RustFS locally; on AWS use an IAM role instead)
S3_ACCESS_KEY=yamesi-local
S3_SECRET_KEY=replace-with-a-long-random-secret
# Password for the demo users admin@yamesi.local and vendedor@yamesi.local
DEMO_PASSWORD=yamesi-demo
